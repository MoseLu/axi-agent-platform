{
  "name": "@axi-agent-platform/desktop-glass-ui",
  "version": "0.1.0",
  "description": "Electron macOS shell for the Axi Agent Platform glass UI.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "app:mac": "AXI_APP_BASE=./ pnpm --dir ../../frontend build && rm -rf dist && cp -R ../../frontend/dist dist && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir"
  },
  "dependencies": {
    "lucide-react": "^0.559.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "build": {
    "appId": "com.axi.agent-platform",
    "productName": "Axi Agent Platform",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ]
    }
  }
}
