# Agent Swarm 环境变量配置

# 应用配置
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./agent_swarm.db
VECTOR_DB_PATH=./chroma_db

# miniMax API配置
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_URL=https://api.minimaxi.com/v1
MINIMAX_DEFAULT_MODEL=abab6-chat

# OpenAI API配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_DEFAULT_MODEL=gpt-4

# 安全配置
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 智能体配置
MAX_AGENTS=10
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# 记忆配置
MAX_SESSION_MEMORY=100
VECTOR_SIMILARITY_TOP_K=5

# SubAgent 模式配置（代码开发协作）
REPOSITORY_PATH=./projects
MAX_WORKTREES=10
MAX_PARALLEL_AGENTS=8
DEFAULT_BASE_BRANCH=main
WORKTREES_CLEANUP_HOURS=24
