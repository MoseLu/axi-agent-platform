# 多模型 API 基础地址（你的统一 API 服务）
SWARM_API_BASE_URL=http://localhost:3000

# 可选：聊天接口路径，默认为 /api/chat。阿里云 DashScope 使用 /v1/chat/completions
# SWARM_CHAT_PATH=/v1/chat/completions

# 可选：API 密钥（若需要 Bearer 或 Api-Key 头）
# SWARM_API_KEY=your-api-key
# 或 Bearer 形式：
# SWARM_API_KEY=Bearer sk-sp-1c698a17937445f4bce9ebbaeab69599

# MiniMax 独立配置（当模型为 MiniMax-M2.5 时使用，不设则走上方统一 API）
# SWARM_MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1
# SWARM_MINIMAX_API_KEY=your-minimax-api-key
# 可选：MiniMax 聊天路径，默认与 SWARM_CHAT_PATH 一致
# SWARM_MINIMAX_CHAT_PATH=chat/completions

# ==================== 数据库配置 ====================

# PostgreSQL (用于向量存储，需要 pgvector 扩展)
DB_POSTGRESQL_HOST=localhost
DB_POSTGRESQL_PORT=5432
DB_POSTGRESQL_DATABASE=mcp_swarm
DB_POSTGRESQL_USER=postgres
DB_POSTGRESQL_PASSWORD=your-password

# MongoDB (用于代码存储)
DB_MONGODB_URI=mongodb://localhost:27017
DB_MONGODB_DATABASE=mcp_swarm

# Redis (用于智能缓存)
DB_REDIS_HOST=localhost
DB_REDIS_PORT=6379
# 可选：Redis 密码
# DB_REDIS_PASSWORD=your-password
