.env
.env.local
.env.*.local

.codebuddy/

backend/__pycache__/
backend/.pytest_cache/
backend/**/*.pyc

frontend/node_modules/
frontend/dist/

apps/*/node_modules/
apps/*/dist/
apps/*/release/

# Nested infra pnpm lockfile is regenerated from package.json at workspace root
infra/**/package-lock.json

# Local databases / vector stores (gitignored, regenerated on first run)
*.db
*.sqlite3
*.sqlite
chroma_db/
chroma/

# SwiftPM build artifacts
.build/

# Auto-submit logs (regenerated by submit hooks, not part of source)
docs/logs/submit/
docs/logs/submit/*.md

# Python virtualenvs (per-env perf sandboxes included)
backend/.venv*/
backend/**/.venv*/

# Local dotfile caches promoted from .git/info/exclude (M18 portability)
tools/axi-todo/.omx/
.omx/

# Append-only SQL dumps (regenerated from pg, not part of source)
tools/axi-todo/.m1-snapshot/*.sql
tools/axi-todo/.m1-snapshot/*.sql.gz

# Stale m1-snapshot root mirror (canonical lives under tools/axi-todo/.m1-snapshot/)
.m1-snapshot/

docs/logs/submit/*.md

# Hook-generated log noise (M18 submission hygiene)
.githooks/*.log
