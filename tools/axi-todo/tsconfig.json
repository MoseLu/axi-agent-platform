{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@axi/core": ["../../../../foundation/axi-ui/packages/core/src/index.ts"],
      "@axi/core/styles.css": ["../../../../foundation/axi-ui/packages/core/dist/styles.css"],
      "@axi/crud": ["../../../../foundation/axi-ui/packages/crud/src/index.ts"],
      "@axi/crud/styles.css": ["../../../../foundation/axi-ui/packages/crud/dist/styles.css"],
      "@axi/presets": ["../../../../foundation/axi-ui/packages/presets/src/index.ts"],
      "@axi/settings": ["../../../../foundation/axi-ui/packages/settings/src/index.ts"],
      "@axi/settings/styles.css": ["../../../../foundation/axi-ui/packages/settings/dist/styles.css"],
      "@axi/widgets": ["../../../../foundation/axi-ui/packages/widgets/src/index.ts"],
      "@axi/widgets/styles.css": ["../../../../foundation/axi-ui/packages/widgets/dist/styles.css"],
      "@axi/shell": ["../../../../foundation/axi-ui/packages/shell/src/index.ts"],
      "@axi/shell/styles.css": ["../../../../foundation/axi-ui/packages/shell/dist/styles.css"],
      "@axi/tokens/brand/app-icons/*": ["../../../../foundation/axi-ui/packages/tokens/dist/brand/app-icons/*"],
      "@axi/tokens/css": ["../../../../foundation/axi-ui/packages/tokens/dist/css/variables.css"],
      "@axi/tokens/ts": ["../../../../foundation/axi-ui/packages/tokens/dist/ts/tokens.d.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/web/**/*.d.ts", "vite.config.ts"]
}
